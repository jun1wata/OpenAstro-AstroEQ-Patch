+int32_t compute_goto_delta_counts(uint32_t current_counts, uint32_t target_counts, uint32_t cpr) {
+    constexpr int64_t kCounterRange = static_cast<int64_t>(kCountsMask) + 1;
+    constexpr int64_t kCounterHalfRange = kCounterRange / 2;
+    int64_t delta = static_cast<int64_t>(target_counts & kCountsMask) -
+                    static_cast<int64_t>(current_counts & kCountsMask);
+    if (delta >= kCounterHalfRange) {
+        delta -= kCounterRange;
+    } else if (delta < -kCounterHalfRange) {
+        delta += kCounterRange;
+    }
+
+    if (cpr != 0) {
+        const int64_t period = static_cast<int64_t>(cpr);
+        delta %= period;
+        const int64_t half_period = period / 2;
+        if (delta > half_period) {
+            delta -= period;
+        } else if (delta < -half_period) {
+            delta += period;
+        }
+    }
+    return static_cast<int32_t>(delta);
+}
