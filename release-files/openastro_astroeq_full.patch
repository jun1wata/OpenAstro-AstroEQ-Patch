+// AstroEQ uses the same inverse for live coordinates and GoTo validation.
+std::pair<double, double> astroeq_axes_to_equatorial(double a1, double a2,
+                                                   double lst, bool south) {
+    const double dec_mech = a2 >= 0.0 ? 90.0 - a2 : 90.0 + a2;
+    const double ha = a1 / kHoursToDegrees + (a2 >= 0.0 ? 6.0 : -6.0);
+    return {wrap_hours(lst - ha), std::clamp(south ? -dec_mech : dec_mech, -90.0, 90.0)};
+}
