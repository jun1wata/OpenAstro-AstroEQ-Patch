@@ -0,0 +1,75 @@
+// Run with Node.js; execute the production UI branches without a live server.
+const fs = require('node:fs');
+const vm = require('node:vm');
+const assert = require('node:assert/strict');
+const path = require('node:path');
+const web = process.argv[2] || path.join(__dirname, '..', 'web');
+const source = fs.readFileSync(process.argv[3] ? web : path.join(web, 'app.js'), 'utf8');
+const html = fs.readFileSync(process.argv[3] || path.join(web, 'index.html'), 'utf8');
+assert(html.includes('<option value="astroeq">AstroEQ</option>'));
+assert(html.includes('<option value="skywatcher">Sky-Watcher Wave (Direct)</option>'));
+const options = new Map();
+const fields = new Map();
+const element = id => {
+    if (!fields.has(id)) fields.set(id, {value: '', style: {}, dispatchEvent() {}});
+    return fields.get(id);
+};
+const vendor = element('vendor');
+vendor.querySelector = selector => {
+    if (!options.has(selector)) options.set(selector, {});
+    return options.get(selector);
+};
+const context = {document: {getElementById: element}, Event: class {},
+    normalizeDeviceType: value => value.toLowerCase()};
+vm.createContext(context);
+vm.runInContext(source.slice(source.indexOf('function updateVendorOptions()'),
+    source.indexOf("document.getElementById('device-type').addEventListener")), context);
+for (const type of ['telescope', 'camera', 'focuser', 'switch', 'filterwheel', 'rotator', 'observingconditions', 'covercalibrator']) {
+    element('device-type').value = type;
+    vendor.value = 'astroeq';
+    context.updateVendorOptions();
+    const option = options.get('option[value="astroeq"]');
+    assert.equal(option.hidden, type !== 'telescope');
+    assert.equal(option.disabled, type !== 'telescope');
+    assert.equal(vendor.value, type === 'telescope' ? 'astroeq' : '');
+}
+function branch(prefix, suffix) {
+    const start = source.indexOf(prefix);
+    assert(start >= 0);
+    const end = source.indexOf(suffix, start);
+    assert(end > start);
+    return source.slice(start, end);
+}
+const displayStart = source.indexOf("document.getElementById('vendor').addEventListener('change'");
+const display = source.slice(displayStart, source.indexOf("} else if (vendor === 'celestron')", displayStart));
+for (const name of ['astroeq', 'skywatcher']) {
+    vm.runInContext(`const vendor = '${name}';\n` + display.slice(display.indexOf("if (vendor ===")) + '}', vm.createContext({...context, updateIoptronConfigFields() {}}));
+    assert.equal(element('skywatcher-config').style.display, 'block');
+}
+const serialize = branch("if (deviceData.vendor === 'skywatcher'", " else if (deviceData.vendor === 'onstep')");
+const restore = branch("if (vendor === 'skywatcher' || vendor === 'astroeq')", " else if (vendor === 'onstep')");
+for (const name of ['astroeq', 'skywatcher']) for (const mode of ['auto', 'serial', 'network']) {
+    const input = new Map(Object.entries({skywatcherConnectionType: mode, skywatcherPortPath: '/dev/ttyACM0',
+        skywatcherBaudRate: '9600', skywatcherHost: '192.0.2.1', skywatcherUdpPort: '11880',
+        skywatcherSiteLatitude: '35', skywatcherSiteLongitude: '139', skywatcherSiteElevation: '42'}));
+    const deviceData = {vendor: name};
+    const c = {deviceData, formData: input, parseInt,
+        applyOpticsMm(form, data) {data.apertureDiameter = .2; data.focalLength = 1; return true;},
+        readOptionalNumber(form, key) {return Number(form.get(key));}};
+    vm.runInNewContext(`(function(){${serialize}})()`, c);
+    assert.equal(deviceData.vendor, name);
+    assert.equal(deviceData.connectionType, mode);
+    assert.equal(deviceData.siteLatitude, 35);
+    assert.equal(deviceData.siteLongitude, 139);
+    assert.equal(deviceData.siteElevation, 42);
+    if (mode === 'serial') {assert.equal(deviceData.portPath, '/dev/ttyACM0'); assert.equal(deviceData.baudRate, 9600);}
+    if (mode === 'network') {assert.equal(deviceData.host, '192.0.2.1'); assert.equal(deviceData.udpPort, 11880);}
+    vm.runInNewContext(restore, {...context, vendor: name, config: deviceData,
+        setFormValue(id, value) {element(id).value = value;},
+        opticsMetersToMm(value) {return value * 1000;}, updateApertureAreaFromDiameter() {}});
+    assert.equal(element('skywatcher-connection-type').value, mode);
+    assert.equal(element('skywatcher-site-latitude').value, 35);
+    assert.equal(element('skywatcher-aperture-diameter').value, 200);
+    assert.equal(element('skywatcher-focal-length').value, 1000);
+}
+console.log('PASS: AstroEQ telescope-only, selection reset, shared form, serial/network/auto serialization and edit restoration; Wave regression');
