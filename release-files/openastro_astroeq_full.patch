+#include <vector>
+#define ALPACA_LOG_INFO(component,message) static_cast<void>(message)
+enum class GotoTargetMode { Incremental, Absolute };
+constexpr int kAxisRa=1, kAxisDec=2;
+struct SkyWatcherProtocolWrapper {
+    std::array<uint32_t,2> positions{0x800000+60000,0x800000-90000};
+    int stops=0;
+    static SkyWatcherProtocolWrapper& instance() { static SkyWatcherProtocolWrapper p; return p; }
+    uint32_t inquire_position(int axis) { return positions.at(axis-1); }
+    void instant_stop(int) { ++stops; }
+};
+struct HomeMount {
+    using Clock=std::chrono::steady_clock;
+    struct { GotoTargetMode goto_target_mode=GotoTargetMode::Incremental; } connection_info_;
+    struct Params { uint32_t counts_per_revolution=13824000; } axis_params_[2];
+    static constexpr double kAstroEqHomeToleranceDeg=120.0/3600.0;
+    static constexpr double kLandingDeadbandDeg=8.0/3600.0;
+    std::atomic<bool> slew_task_cancel_{false};
+    bool connected_=true, at_home_=false, homing_=true, goto_in_progress_=false;
+    bool tracking=true, running=false, cancel_wait=false;
+    double cmd_axis_rate_deg_s_[2]{};
+    Clock::time_point slew_force_until_{}, time{};
+    int dispatches=0, waits=0, tracking_calls=0, seconds_per_pass=1;
+    std::vector<std::array<int32_t,2>> landings{{8191,-41000},{319,-9272},{65,-376}};
+    std::vector<std::array<int32_t,2>> deltas;
+    Clock::time_point home_now() const { return time; }
+    bool get_hardware_slewing_locked() const { return running; }
+    void set_tracking_locked(std::unique_lock<std::mutex>&,bool enabled) {
+        if(enabled || !homing_ || goto_in_progress_) throw std::runtime_error("Home state/tracking conflict");
+        tracking=enabled; ++tracking_calls;
+    }
+    void refresh_position_cache_locked(bool force) { if(!force) throw std::runtime_error("stale Home read"); }
+    void dispatch_goto_locked(std::unique_lock<std::mutex>&,double a1,double a2,bool planned=false) {
+        if(!homing_ || goto_in_progress_ || tracking || a1!=0.0 || a2!=0.0)
+            throw std::runtime_error("Home/GoTo state mixed or target changed");
+        if(connection_info_.goto_target_mode==GotoTargetMode::Incremental && !planned)
+            throw std::runtime_error("Home did not use direct incremental planner");
+        auto& proto=SkyWatcherProtocolWrapper::instance();
+        const auto ra=astroeq_incremental_move(proto.positions[0],0.0,axis_params_[0].counts_per_revolution);
+        const auto dec=astroeq_incremental_move(proto.positions[1],0.0,axis_params_[1].counts_per_revolution);
+        if(!ra.valid || !dec.valid || ra.predicted!=0x800000 || dec.predicted!=0x800000)
+            throw std::runtime_error("Home incremental endpoint mismatch");
+        deltas.push_back({ra.delta,dec.delta});
+        running=true; ++dispatches;
+    }
+    void wait_for_slew_complete(std::unique_lock<std::mutex>&,
+                               std::chrono::seconds timeout=std::chrono::seconds(180)) {
+        if(!homing_ || goto_in_progress_ || tracking) throw std::runtime_error("Home state gap");
+        ++waits;
+        if(std::chrono::seconds(seconds_per_pass)>timeout) {
+            time+=timeout+std::chrono::seconds(1);
+            throw AlpacaException("scripted overall timeout");
+        }
+        time+=std::chrono::seconds(seconds_per_pass);
+        auto& pos=SkyWatcherProtocolWrapper::instance().positions;
+        const auto& landing=landings.at(waits-1);
+        pos={static_cast<uint32_t>(0x800000+landing[0]),static_cast<uint32_t>(0x800000+landing[1])};
+        running=false;
+        if(cancel_wait) slew_task_cancel_.store(true);
+    }
+'''
+method=function('void run_astroeq_count_home_locked(')
+assert method.count('std::chrono::seconds(540)')==1
+assert method.index('const auto deadline')<method.index('for (int pass')
+# Substitute only the monotonic clock dependency, so timeout tests are instant.
+code+=method.replace('std::chrono::steady_clock::now()','home_now()')
+# Exercise the retained production Wave count-frame branch separately.
+find_home=function('void find_home(')
+needle='else {\n                    // No sensors: goto the power-on index'
+start=find_home.index(needle)+len('else ')
+end=start+1;depth=1
+while depth:
+    depth+=(find_home[end]=='{')-(find_home[end]=='}')
+    end+=1
+code+='void wave_count_home(std::unique_lock<std::mutex>& lock) '+find_home[start:end]+'\n'
+code+=r'''
+};
+void check(bool b,const char* msg) { if(!b) throw std::runtime_error(msg); }
+void reset(int32_t ra=60000,int32_t dec=-90000) {
+    auto& p=SkyWatcherProtocolWrapper::instance();
+    p.positions={static_cast<uint32_t>(0x800000+ra),static_cast<uint32_t>(0x800000+dec)};
+    p.stops=0;
+}
+int main() {
+    std::mutex mutex; std::unique_lock<std::mutex> lock(mutex);
+    for(int success_pass:{1,2,3,4}) {
+        reset(); HomeMount m;
+        m.landings.assign(success_pass,{8191,-41000});
+        m.landings.back()={65,-376};
+        m.run_astroeq_count_home_locked(lock);
+        check(m.at_home_ && !m.tracking && !m.goto_in_progress_ && m.homing_,"Home success state wrong");
+        check(m.dispatches==success_pass && m.waits==success_pass,"Home pass count wrong");
+        std::cout<<"PASS Home success on pass "<<success_pass<<'\n';
+    }
+    {
+        reset(); HomeMount m;
+        m.run_astroeq_count_home_locked(lock);
+        check(m.dispatches==3 && m.deltas[1][0]==-8191 && m.deltas[1][1]==41000 &&
+              m.deltas[2][0]==-319 && m.deltas[2][1]==9272,"logged residual corrections wrong");
+        check(m.at_home_ && !m.tracking,"logged Home reproduction failed");
+        std::cout<<"REPRO passes=3 pass2_delta=-8191,+41000 pass3_delta=-319,+9272 final_error_counts=65,376\n";
+    }
+    {
+        reset(); HomeMount m; m.landings.assign(4,{8191,-41000});
+        bool failed=false;
+        try { m.run_astroeq_count_home_locked(lock); } catch(const AlpacaException&) { failed=true; }
+        check(failed && m.waits==4 && m.dispatches==4 && !m.at_home_ && !m.tracking,
+              "fourth pass failure not bounded");
+    }
+    for(const auto& initial:{std::array<int32_t,2>{8191,0},{0,-41000},{8191,-41000}}) {
+        reset(initial[0],initial[1]); HomeMount m;
+        m.landings={initial,{65,-376}};
+        m.run_astroeq_count_home_locked(lock);
+        check(m.at_home_ && m.dispatches==2,"single/both-axis correction failed");
+        check(m.deltas[0][0]==-initial[0] && m.deltas[0][1]==-initial[1],"incorrect axis delta");
+    }
+    for(const auto& cpr:{std::pair<uint32_t,uint32_t>{13824000,13824000},{9216000,12800000}}) {
+        reset(1000,-1000); HomeMount m;
+        m.axis_params_[0].counts_per_revolution=cpr.first;
+        m.axis_params_[1].counts_per_revolution=cpr.second;
+        m.landings={{853,-1185}};
+        m.run_astroeq_count_home_locked(lock);
+        check(m.at_home_ && !m.tracking,"independent CPR tolerance failed");
+        check(m.dispatches==(cpr.first==13824000?0:1),"CPR-dependent RA tolerance ignored");
+    }
+    {
+        reset(65,-376); HomeMount m;
+        m.run_astroeq_count_home_locked(lock);
+        check(m.at_home_ && m.dispatches==0 && !m.tracking,"already Home state failed");
+    }
+    {
+        reset(); HomeMount m; m.landings.assign(4,{8191,-41000}); m.seconds_per_pass=205;
+        bool failed=false;
+        try { m.run_astroeq_count_home_locked(lock); } catch(const AlpacaException&) { failed=true; }
+        check(failed && m.dispatches==3 && m.waits==3 && !m.at_home_ && !m.tracking &&
+              SkyWatcherProtocolWrapper::instance().stops==2,"overall deadline reset or failed to stop axes");
+    }
+    {
+        reset(); HomeMount m; m.cancel_wait=true;
+        bool failed=false;
+        try { m.run_astroeq_count_home_locked(lock); } catch(const AlpacaException&) { failed=true; }
+        check(failed && m.dispatches==1 && !m.at_home_ && !m.tracking,"cancelled Home continued");
+    }
+    {
+        reset(); HomeMount m; m.tracking=false;
+        m.connection_info_.goto_target_mode=GotoTargetMode::Absolute;
+        m.landings={{8191,-41000}};
+        m.wave_count_home(lock);
+        check(m.dispatches==1 && m.waits==1,"Wave acquired AstroEQ correction loop");
+    }
+    std::cout<<"PASS four-pass failure, RA/DEC residuals, independent CPRs, already Home, deadline, cancellation, Wave\n";
+}
+'''
+build=root/'AlpacaHTTP/build-skywatcher-test'
+cpp=build/'test_astroeq_home.cpp';binary=build/'test_astroeq_home'
+cpp.write_text(code)
+subprocess.run(['c++','-std=c++20','-Wall','-Wextra','-Werror',str(cpp),'-o',str(binary)],check=True)
+subprocess.run([str(binary)],check=True)
