+// Both hemispheres use the same RA home phase. D=-Dec changes DEC
+// angles in the south, not the counterweight-down RA half revolution.
+bool astroeq_desired_positive_dec_axis(double ha, double current_dec_axis) {
+    constexpr double kMeridianEpsilonHours = 1.0 / (3600.0 * kHoursToDegrees);
+    if (std::abs(ha) < kMeridianEpsilonHours) {
+        return current_dec_axis >= 0.0;
+    }
+    return ha > 0.0;
+}
