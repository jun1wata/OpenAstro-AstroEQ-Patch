+struct AstroEqIncrementalMove {
+    uint32_t current;
+    uint32_t target;
+    int32_t delta;
+    uint32_t increment;
+    uint32_t predicted;
+    bool valid;
+    char direction() const { return delta >= 0 ? '0' : '1'; }
+};
+
+AstroEqIncrementalMove astroeq_incremental_move(uint32_t current, double target_axis, uint32_t cpr) {
+    if (cpr == 0 || current > kCountsMask || !std::isfinite(target_axis)) {
+        return {current, 0, 0, 0, 0, false};
+    }
+    // Home-centered machine angles select the intended turn explicitly.
+    // A raw 24-bit counter wraps at 2^24, NOT at counts_per_revolution.
+    // Do not reduce this relative move modulo either period: a GEM flip
+    // can legitimately need more than half a counter range or revolution.
+    const int64_t target = static_cast<int64_t>(kHomeCounts) +
+        std::llround(target_axis / 360.0 * static_cast<double>(cpr));
+    if (target < 0 || target > kCountsMask) {
+        return {current, 0, 0, 0, 0, false};
+    }
+    const int32_t delta = static_cast<int32_t>(target - static_cast<int64_t>(current));
+    const uint32_t increment = static_cast<uint32_t>(std::abs(static_cast<int64_t>(delta)));
+    const char direction = delta >= 0 ? '0' : '1';
+    const int64_t signed_increment = direction == '0' ? static_cast<int64_t>(increment)
+                                                     : -static_cast<int64_t>(increment);
+    const uint32_t predicted = static_cast<uint32_t>(
+        static_cast<int64_t>(current) + signed_increment) & kCountsMask;
+    return {current, static_cast<uint32_t>(target), delta, increment, predicted, increment <= kCountsMask};
+}
+
+struct AstroEqGemCandidate {
+    double axis1;
+    double axis2;
+    double roundtrip_ra;
+    double roundtrip_dec;
+    double travel;
+    bool valid;
+    AstroEqIncrementalMove ra_move{};
+    AstroEqIncrementalMove dec_move{};
+    double error_arcsec = 0.0;
+};
+
+AstroEqGemCandidate astroeq_gem_candidate(double ra, double dec, double lst, bool south,
+                                        bool positive_dec_axis, double current1, double current2,
+                                        uint32_t cpr1, uint32_t cpr2) {
+    const double ha = wrap_hour_angle(lst - ra);
+    const double dec_mech = south ? -dec : dec;
+    // Keep equivalent RA turns inside the centered counter frame before
+    // converting to 24 bits (the counter period is not one revolution).
+    const double a1 = std::remainder(
+        (ha + (positive_dec_axis ? -6.0 : 6.0)) * kHoursToDegrees, 360.0);
+    const double a2 = positive_dec_axis ? 90.0 - dec_mech : dec_mech - 90.0;
+    if (cpr1 == 0 || cpr2 == 0) {
+        return {a1, a2, 0.0, 0.0, 0.0, false};
+    }
+    const auto move1 = astroeq_incremental_move(degrees_to_counts(current1, cpr1), a1, cpr1);
+    const auto move2 = astroeq_incremental_move(degrees_to_counts(current2, cpr2), a2, cpr2);
+    const double landed1 = counts_to_degrees(move1.predicted, cpr1);
+    const double landed2 = counts_to_degrees(move2.predicted, cpr2);
+    const auto [back_ra, back_dec] = astroeq_axes_to_equatorial(landed1, landed2, lst, south);
+    const double ra_error = std::abs(dec) == 90.0 ? 0.0 :
+        std::abs(wrap_hour_angle(back_ra - ra)) * kHoursToDegrees * 3600.0;
+    const double dec_error = std::abs(back_dec - dec) * 3600.0;
+    const double error = std::max(ra_error, dec_error);
+    const bool valid = move1.valid && move2.valid && std::isfinite(error) && error <= 3.0;
+    const double travel = static_cast<double>(move1.increment) * 360.0 / cpr1 +
+                          static_cast<double>(move2.increment) * 360.0 / cpr2;
+    return {landed1, landed2, back_ra, back_dec, travel, valid, move1, move2, error};
+}
+
+double astroeq_angular_error_arcsec(double ra, double dec, double actual_ra, double actual_dec) {
+    constexpr double rad = std::numbers::pi / 180.0;
+    const double delta_ra = wrap_hour_angle(actual_ra - ra) * kHoursToDegrees * rad;
+    const double d1 = dec * rad;
+    const double d2 = actual_dec * rad;
+    const double x = std::cos(d2) * std::sin(delta_ra);
+    const double y = std::cos(d1) * std::sin(d2) - std::sin(d1) * std::cos(d2) * std::cos(delta_ra);
+    const double z = std::sin(d1) * std::sin(d2) + std::cos(d1) * std::cos(d2) * std::cos(delta_ra);
+    return std::atan2(std::hypot(x, y), z) / rad * 3600.0;
+}
