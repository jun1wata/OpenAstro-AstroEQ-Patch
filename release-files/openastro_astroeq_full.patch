+#!/usr/bin/env python3
+# AlpacaCore
+# Copyright (c) 2025-2026 Joey Troy and contributors
+# SPDX-License-Identifier: AGPL-3.0-or-later
+"""Compile production discovery functions and test serial probing with PTYs.
+
+Run from the repository root. --live additionally enumerates real ports, only
+when /dev/ttyACM0 is unused; no server is started and no motion is commanded.
+"""
+from pathlib import Path
+import os
+import pty
+import select
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parents[2]
+source = (root / 'AlpacaCore/src/vendors/skywatcher/skywatcher_protocol_wrapper.cpp').read_text()
+build = root / 'AlpacaHTTP/build-skywatcher-test'
+
+def function(name):
+    start = source.index(name)
+    start = source.rfind('\n', 0, start) + 1
+    end = source.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end] + '\n'
+
+code = r'''
+#include <alpacacore/util/serial_by_id_scan.h>
+#include <alpacacore/util/serial_io.h>
+#include <alpacacore/vendor/skywatcher/skywatcher_protocol_wrapper.h>
+#include <chrono>
+#include <filesystem>
+#include <fcntl.h>
+#include <iostream>
+#include <set>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <termios.h>
+#include <unistd.h>
+#include <vector>
+namespace util=alpacacore::util;
+using alpacacore::vendor::skywatcher::SkyWatcherPortInfo;
+constexpr char kFrameEnd='\r', kReplyOk='=';
+#define ALPACA_LOG_INFO(component,message) (std::cout << (message) << std::endl)
+'''
+for name in ('int hex_nibble(', 'std::string format_mc_version(',
+             'bool skywatcher_serial_candidate(', 'std::string parse_skywatcher_serial_probe_reply(',
+             'std::string probe_skywatcher_port(', 'bool raw_port_looks_like_skywatcher_candidate(',
+             'std::vector<SkyWatcherPortInfo> enumerate_skywatcher_ports('):
+    code += function(name)
+code += r'''
+void check(bool b,const char* msg) { if(!b) throw std::runtime_error(msg); }
+int main(int argc,char** argv) {
+    if(argc==2) {
+        if(std::string(argv[1])=="--enumerate") {
+            const auto ports=enumerate_skywatcher_ports();
+            for(const auto& p:ports) std::cout<<"ACCEPTED "<<p.port_path<<'\n';
+            return ports.empty()?2:0;
+        }
+        const auto version=probe_skywatcher_port(argv[1],9600);
+        std::cout<<version<<std::endl;
+        return version.empty()?2:0;
+    }
+    using util::UsbTtyDescriptor;
+    check(skywatcher_serial_candidate({"1a86","wch.cn","USB Serial CH340"}),"CH340 excluded");
+    check(skywatcher_serial_candidate({"0483","STMicroelectronics","STM32 Virtual ComPort"}),"Wave STM32 excluded");
+    check(skywatcher_serial_candidate({"2341","Arduino SA","Mega 2560 R3"}),"Arduino Mega excluded");
+    check(skywatcher_serial_candidate({"2341","",""}),"Arduino VID excluded");
+    check(skywatcher_serial_candidate({"","","Mega_2560"}),"Mega product excluded");
+    for(const std::string token:{"Arduino","Arduino SA","2341","Mega","Mega_2560",
+                                "CH340","CH341","FTDI","CP210","Prolific","STM32"}) {
+        check(skywatcher_serial_candidate({"","usb-"+token+"-if00",""}),"by-id signature excluded");
+    }
+    check(skywatcher_serial_candidate({"","usb-Arduino__www.arduino.cc__0042_9503630343535111B011-if00",""}),
+          "real Mega by-id excluded");
+    check(!skywatcher_serial_candidate({"ffff","Unrelated","GPS receiver"}),"unrelated descriptor admitted");
+    check(parse_skywatcher_serial_probe_reply("=033A44")=="3.58.68","Wave firmware regression");
+    for(const std::string reply:{"","!0","=","=123","=GGGGGG","=033A44junk"})
+        check(parse_skywatcher_serial_probe_reply(reply).empty(),"invalid reply accepted");
+    std::cout<<"PASS descriptor/by-id candidates, Arduino Mega, legacy cables, Wave and invalid MC replies\n";
+}
+'''
+cpp = build / 'test_skywatcher_serial_detection.cpp'
+binary = build / 'test_skywatcher_serial_detection'
+cpp.write_text(code)
+subprocess.run(['c++', '-std=c++20', '-Wall', '-Wextra', '-Werror',
+                '-I'+str(root/'AlpacaCore/include'), str(cpp), '-o', str(binary)], check=True)
+subprocess.run([str(binary)], check=True)
+
+for label, reply, accepted in (
+    ('Wave valid MC', b'=033A44\r', True),
+    ('Arduino valid MC', b'=010203\r', True),
+    ('Arduino boot-delay retry', b'RETRY', True),
+    ('unrelated protocol', b'GPS receiver\r', False),
+    ('Arduino without MC reply', None, False),
+    ('invalid MC hex', b'=GGGGGG\r', False),
+    ('unterminated MC reply', b'=033A44', False),
+):
+    master, slave = pty.openpty()
+    proc = subprocess.Popen([str(binary), os.ttyname(slave)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    try:
+        if not select.select([master], [], [], 5)[0]:
+            raise RuntimeError('Probe sent no command: '+label)
+        command = os.read(master, 1024)
+        if command != b':e1\r':
+            raise RuntimeError('Unexpected probe command: '+repr(command))
+        if reply == b'RETRY':
+            if not select.select([master], [], [], 5)[0]:
+                raise RuntimeError('Missing startup retry')
+            if os.read(master, 1024) != b':e1\r':
+                raise RuntimeError('Unexpected retry command')
+            os.write(master, b'=010203\r')
+        elif reply is not None:
+            os.write(master, reply)
+        stdout, stderr = proc.communicate(timeout=5)
+        if (proc.returncode == 0) != accepted:
+            raise RuntimeError(f'{label}: exit={proc.returncode}, out={stdout!r}, err={stderr!r}')
+        print(f'PASS PTY {label}: '+('accepted' if accepted else 'rejected'))
+    finally:
+        if proc.poll() is None:
+            proc.kill()
+            proc.wait()
+        os.close(master)
+        os.close(slave)
+
+enumeration = function('std::vector<SkyWatcherPortInfo> enumerate_skywatcher_ports(')
+assert enumeration.index('list_serial_by_id') < enumeration.index('raw_candidates')
+assert 'probed.count(resolved)' in enumeration
+assert 'i < 10' in enumeration and '"/dev/ttyACM"' in enumeration and '"/dev/ttyUSB"' in enumeration
+assert enumeration.count('probe_skywatcher_port(resolved, 9600)') == 2
+print('PASS by-id priority, deduplication, raw ACM/USB 0..9 fallback and 9600 baud preserved')
+
+if '--live' in sys.argv:
+    busy = subprocess.run(['fuser', '/dev/ttyACM0'], capture_output=True)
+    if busy.returncode != 1:
+        raise SystemExit('Refusing live probe: ttyACM0 is busy or ownership check failed')
+    subprocess.run([str(binary), '--enumerate'], check=True, timeout=45)
