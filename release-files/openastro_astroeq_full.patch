+template <typename Protocol>
+std::pair<AxisParameters, AxisParameters> query_astroeq_axis_parameters(Protocol& protocol) {
+    try {
+        const auto ra = protocol.get_axis_parameters(1);
+        const auto dec = protocol.get_axis_parameters(2);
+        // The reply is an unsigned 24-bit CPR, independent of Home and the
+        // counter period. Do not impose a mount-specific gear-ratio range.
+        for (const auto cpr : {ra.counts_per_revolution, dec.counts_per_revolution}) {
+            if (cpr <= 1 || cpr > kCountsMask) {
+                throw AlpacaException("invalid counts/revolution " + std::to_string(cpr));
+            }
+        }
+        ALPACA_LOG_WARN("SkyWatcher", "[SkyWatcher][AstroEQ] axis=1 counts_per_revolution=" +
+            std::to_string(ra.counts_per_revolution));
+        ALPACA_LOG_WARN("SkyWatcher", "[SkyWatcher][AstroEQ] axis=2 counts_per_revolution=" +
+            std::to_string(dec.counts_per_revolution));
+        return {ra, dec};
+    } catch (const std::exception& ex) {
+        throw AlpacaException("AstroEQ counts/revolution query failed: " + std::string(ex.what()));
+    } catch (...) {
+        throw AlpacaException("AstroEQ counts/revolution query failed: unknown protocol error");
